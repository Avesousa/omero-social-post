{
  "name": "@omero/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared contracts for omero-social-post: zod schemas, provider limits, X weighted counter, thread splitter and per-provider validation.",
  "license": "AGPL-3.0-only",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "twitter-text": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@omero/config": "workspace:*",
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
