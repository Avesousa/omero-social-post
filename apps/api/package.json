    "@testcontainers/redis": "^12.2.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.11",
    "msw": "^3.0.3",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
