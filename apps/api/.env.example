# omero-social-post API — copy to apps/api/.env for local development.
# Never commit the real .env. Production gets these from Docker Compose.

# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
PORT=4000
# 0.0.0.0 inside containers; keep 127.0.0.1 on a dev box.
HOST=127.0.0.1

# Public origin of the web app (OAuth redirects, Origin checks). No trailing slash.
# In production: https://<host>.<tailnet>.ts.net
PUBLIC_BASE_URL=http://localhost:3000

# Matches infra/docker-compose.dev.yml (`pnpm infra:up`).
DATABASE_URL=postgres://omero:omero@127.0.0.1:5432/omero
REDIS_URL=redis://127.0.0.1:6379/0

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Losing it makes stored OAuth tokens unreadable (channels must reconnect).
ENCRYPTION_KEY=

# Uploaded images (relative to apps/api when running locally).
MEDIA_DIR=./media-data
# Run BullMQ workers in this process (true/false).
WORKERS_ENABLED=true

# --- Optional integrations: set both values of a pair, or neither. ---
# X (Twitter) OAuth 2.0 app: https://developer.x.com
X_CLIENT_ID=
X_CLIENT_SECRET=
# LinkedIn app (Share on LinkedIn + Sign In with LinkedIn using OpenID Connect)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Telegram notifications (BotFather token + your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
