{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["API_INTERNAL_URL"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "REDIS_URL", "TEST_DATABASE_URL", "TEST_REDIS_URL"],
      "passThroughEnv": [
        "NODE_ENV",
        "PUBLIC_BASE_URL",
        "ENCRYPTION_KEY",
        "MEDIA_DIR",
        "TEST_CONTAINERS",
        "TEST_LOG_LEVEL",
        "DOCKER_HOST",
        "TESTCONTAINERS_*"
      ]
    },
    "@omero/api-client#generate": {
      "dependsOn": ["@omero/api#generate"],
      "cache": false
    }
  }
}
