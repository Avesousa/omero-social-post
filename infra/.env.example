# omero-social-post environment configuration.
#
# Copy this file to `.env` next to docker-compose.yml and fill in the values:
#     cp infra/.env.example infra/.env          # in a checkout
#     cp .env.example /opt/omero/.env           # on the server (see infra/README.md)
# Never commit the real `.env`: it is git-ignored and gitleaks blocks secrets in commits.
# On the server keep it private: chmod 600 /opt/omero/.env
#
# Legend: [required] must be set; [optional] the app works without it (the related feature is
# disabled or a default is used). Values shown are placeholders or safe local defaults.

# -----------------------------------------------------------------------------
# Deployment (Docker Compose)
# -----------------------------------------------------------------------------

# [optional] Image tag pulled from GHCR for both api and web: `latest` (last build of main),
# a release such as `0.1.0` / `0.1`, or `sha-<short commit>`. Default: latest.
OMERO_VERSION=latest

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# [optional] Runtime mode: production | development | test. Default: production.
NODE_ENV=production

# [optional] Port the API listens on. Default: 4000. In docker-compose.yml the api service
# pins it to 4000 (the web image's rewrite expects it), so this only matters outside Docker.
PORT=4000

# [required] Public URL where you open the app. With Tailscale this is the HTTPS name that
# `tailscale serve` gives the machine. It is used for OAuth callbacks, links in notifications
# and the CSRF Origin check, so it must match the URL in your browser exactly (no trailing slash).
# Local development: http://localhost:3000
PUBLIC_BASE_URL=https://<host>.<tailnet>.ts.net

# [build time] URL the web server uses to reach the API (the web app rewrites /api/* to it).
# Next.js bakes it in when `next build` runs, so it is NOT read by the running web container:
# the published web image is built with http://api:4000 (the compose service name). Set it only
# when you build the web image or run `next build` yourself. Local development: http://localhost:4000
API_INTERNAL_URL=http://api:4000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------

# [required] Connection string. Credentials must match the Postgres container section below,
# and the host is the compose service name `postgres`. If the password has characters such as
# @ : / ? # %, URL-encode them here (or generate one without them: openssl rand -hex 24).
# Local development (Postgres published on 127.0.0.1): postgres://omero:<password>@localhost:5432/omero
DATABASE_URL=postgres://omero:change-me@postgres:5432/omero

# -----------------------------------------------------------------------------
# Redis (BullMQ queues)
# -----------------------------------------------------------------------------

# [required] Redis 8 connection string. Local development: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# [required] 32-byte key, base64-encoded, used to encrypt OAuth tokens at rest (AES-256-GCM).
# Generate one with:
#     openssl rand -base64 32
# Keep a backup: if you lose it, every connected channel has to be reconnected.
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Media
# -----------------------------------------------------------------------------

# [optional] Directory where uploaded images are stored (mount a volume here in Docker).
# Default: /data/media
MEDIA_DIR=/data/media

# -----------------------------------------------------------------------------
# Workers
# -----------------------------------------------------------------------------

# [optional] Run the BullMQ workers (publishing, metrics, reconciler) inside the API process.
# Set to false only if you run the workers in a separate container. Default: true
WORKERS_ENABLED=true

# -----------------------------------------------------------------------------
# X (Twitter) - bring your own developer app
# -----------------------------------------------------------------------------
# [optional] Without these, "Connect X" is disabled in Settings -> Channels.
# Create an app at https://developer.x.com with OAuth 2.0 enabled (type: Web App).
# Callback URL to register: ${PUBLIC_BASE_URL}/api/v1/channels/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# LinkedIn - bring your own developer app
# -----------------------------------------------------------------------------
# [optional] Without these, "Connect LinkedIn" is disabled in Settings -> Channels.
# Create an app at https://www.linkedin.com/developers with the products
# "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect".
# Redirect URL to register: ${PUBLIC_BASE_URL}/api/v1/channels/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Telegram notifications
# -----------------------------------------------------------------------------
# [optional] Without these, notifications are in-app only.
# Create a bot with @BotFather to get the token, then send it a message and read your chat id
# from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Postgres container
# -----------------------------------------------------------------------------
# [required for Docker Compose] Used by the postgres image to create the database on first start.
# Keep them in sync with DATABASE_URL above.
POSTGRES_USER=omero
POSTGRES_PASSWORD=change-me
POSTGRES_DB=omero
